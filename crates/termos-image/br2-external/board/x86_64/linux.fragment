# What a PC needs beyond every board's (D-124): ACPI's battery, mains
# power, lid and laptop backlight, and AMD's graphics driver as a module
# (its firmware is on the root file system, which a built-in driver would
# start before).
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=y
CONFIG_MODULES=y
CONFIG_DRM_AMDGPU=m
# Bluetooth adapters on USB, as laptops have them (D-128): modules, so
# their firmware is there when they load.
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
