# Raspberry Pi: the VideoCore display driver built in, so the console has
# a display before modules load.
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
# HDMI audio through vc4 (D-128).
CONFIG_SND_SOC=y
# Bluetooth on the Broadcom chip's UART (D-128): a module, so its firmware
# is there when it loads.
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
