#!/bin/sh
# tty1: TermOS's console, as the user `termos` (D-073, D-075). What it
# prints (its ready marker, errors) goes to the system console, which is
# the serial port in the QEMU boot tests.

uid=$(id -u termos)
run=/run/user/$uid
mkdir -p "$run"
chown termos:termos "$run"
chmod 0700 "$run"

# The console leaves a file here after its first frame; S98termos-slot
# then marks the booted slot good (D-078).
mkdir -p /run/termos
chown termos:termos /run/termos
rm -f /run/termos/console-ready
export TERMOS_READY_FILE=/run/termos/console-ready

export HOME=/home/termos USER=termos LOGNAME=termos SHELL=/bin/sh
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
export XDG_RUNTIME_DIR="$run"
cd "$HOME" || exit 1
# Sound and the session bus first (user-session), then the console.
exec su -p -s /bin/sh -c 'exec /usr/libexec/termos/user-session' termos > /dev/console 2>&1
