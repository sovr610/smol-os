#!/bin/sh
# The data partition (D-075): homes, iwd's networks, D-Bus's machine ID,
# dhcpcd's leases, RAUC's records, the users' passwords and the time zone
# (D-124), and later the dev rootfs, models and containers. The root file
# system is read-only. Also the boot partition, on /boot/esp, for RAUC and
# the boot loader (D-078), and a tmpfs on /media for USB drives.

DATA_LABEL=termos-data

# The partitions of the disk the system booted from (D-124): the one with
# the root slot the kernel mounted (root=PARTUUID=…). On GPT they are found
# by name (boot, rootfs-a, rootfs-b, data); on MBR (a Pi, or a disk
# installed before GPT) by number. Written to /run/termos/disk for
# S80rauc.
find_parts() {
	BOOT= ROOTFS_A= ROOTFS_B= DATA= DISK=
	uuid=$(sed -n 's/.*root=PARTUUID=\([^ ]*\).*/\1/p' /proc/cmdline)
	[ -n "$uuid" ] || return 0
	root=$(readlink -f "/dev/disk/by-partuuid/$uuid" 2>/dev/null)
	[ -n "$root" ] && [ -b "$root" ] || return 0
	DISK=$(basename "$(readlink -f "/sys/class/block/${root##*/}/..")")
	for p in "/sys/class/block/$DISK/$DISK"*; do
		[ -e "$p/partition" ] || continue
		dev=/dev/${p##*/}
		case "$(sed -n 's/^PARTNAME=//p' "$p/uevent")" in
		boot) BOOT=$dev ;;
		rootfs-a) ROOTFS_A=$dev ;;
		rootfs-b) ROOTFS_B=$dev ;;
		data) DATA=$dev ;;
		"")
			case "$(cat "$p/partition")" in
			1) BOOT=$dev ;;
			2) ROOTFS_A=$dev ;;
			3) ROOTFS_B=$dev ;;
			4) DATA=$dev ;;
			esac
			;;
		esac
	done
	mkdir -p /run/termos
	printf 'DISK=/dev/%s\nBOOT=%s\nROOTFS_A=%s\nROOTFS_B=%s\nDATA=%s\n' \
		"$DISK" "$BOOT" "$ROOTFS_A" "$ROOTFS_B" "$DATA" >/run/termos/disk
}

# On the first boot of a disk bigger than the image (installed, written with
# dd, a virtual disk made bigger), the data partition, the last one, grows
# to the end of the disk (D-080). On GPT the backup table first moves to
# the disk's end (MBR sizes stop at 2 TiB). $part is the data partition's
# device.
grow() {
	[ -n "$part" ] || return 0
	name=${part##*/}
	num=$(cat "/sys/class/block/$name/partition" 2>/dev/null)
	[ -n "$num" ] || return 0
	disk=$(basename "$(readlink -f "/sys/class/block/$name/..")")
	start=$(cat "/sys/class/block/$name/start")
	size=$(cat "/sys/class/block/$name/size")
	total=$(cat "/sys/class/block/$disk/size")
	# Only the last partition on the disk grows.
	for p in "/sys/class/block/$disk/$disk"*; do
		[ -e "$p/start" ] || continue
		[ "$(cat "$p/start")" -le "$start" ] || return 0
	done
	# Less than 16 MiB to gain: nothing to do.
	[ $((total - start - size)) -ge 32768 ] || return 0
	echo "termos: growing the data partition to the end of /dev/$disk"
	if [ "$(dd if="/dev/$disk" bs=1 skip=512 count=8 2>/dev/null)" = "EFI PART" ]; then
		sfdisk --quiet --no-reread --no-tell-kernel --relocate gpt-bak-std "/dev/$disk" ||
			echo "termos: could not move the GPT's backup to the disk's end"
	fi
	echo ", +" | sfdisk --quiet --no-reread --no-tell-kernel -N "$num" "/dev/$disk" &&
		partx --update --nr "$num" "/dev/$disk" && GROWN=$part
}

start() {
	udevadm settle 2>/dev/null
	# The live ISO (D-080) keeps nothing and touches no disk, not even a
	# TermOS one already in the machine.
	if grep -q 'termos\.live' /proc/cmdline; then
		echo "termos: running from the live ISO: nothing will be kept"
		mount -t tmpfs -o mode=0755 data /data
		data_binds
		return
	fi
	find_parts
	if [ -z "$BOOT" ] || ! err=$(mount -t vfat -o noatime,umask=0077 "$BOOT" /boot/esp 2>&1); then
		echo "termos: no boot partition on /boot/esp: ${err:-not found}"
	fi
	GROWN=
	# Found before growing: udev takes the partition's links away for a
	# moment while it looks at the grown partition again. An older disk
	# without the boot disk's partitions found has its data by label.
	part=$DATA
	[ -n "$part" ] || part=$(readlink -f "/dev/disk/by-label/$DATA_LABEL" 2>/dev/null)
	grow
	udevadm settle 2>/dev/null
	if [ -n "$part" ] && [ -b "$part" ] && mount -t ext4 -o noatime "$part" /data; then
		echo "termos: data on $part"
		# ext4 grows while mounted.
		[ -z "$GROWN" ] || resize2fs "$GROWN" >/dev/null 2>&1 ||
			echo "termos: could not grow the data file system"
	else
		# No data partition (a new disk layout, or a broken
		# one): keep going in memory rather than formatting anything by guess.
		echo "termos: no $DATA_LABEL partition: nothing will be kept"
		mount -t tmpfs -o mode=0755 data /data
	fi
	data_binds
}

data_binds() {
	mkdir -p /data/home/termos /data/iwd /data/dbus /data/dhcpcd /data/rauc \
		/data/dev-rootfs /data/models /data/containers
	chown termos:termos /data/home/termos
	chmod 0700 /data/home/termos
	mount --bind /data/home /home
	mount --bind /data/iwd /var/lib/iwd
	# /var/lib/dbus links to /tmp/dbus (Buildroot, for read-only roots).
	mkdir -p /tmp/dbus
	mount --bind /data/dbus /tmp/dbus
	mount --bind /data/dhcpcd /var/db/dhcpcd
	# The users' passwords (D-124): /etc/shadow links here, and a newer
	# image's new users get their entries (passwords already set stay).
	mkdir -p /data/etc
	if [ ! -e /data/etc/shadow ]; then
		cp /usr/share/termos/shadow /data/etc/shadow
	else
		awk -F: 'NR == FNR { have[$1] = 1; next } !($1 in have)' \
			/data/etc/shadow /usr/share/termos/shadow >>/data/etc/shadow
	fi
	chown root:root /data/etc/shadow
	chmod 0600 /data/etc/shadow
	# The time zone: /etc/localtime links here (`termos system
	# set-time-zone` changes it); UTC to start.
	[ -e /data/etc/localtime ] || ln -sfn /usr/share/zoneinfo/Etc/UTC /data/etc/localtime
	# USB drives are mounted under /media (`termos system mount`).
	mount -t tmpfs -o mode=0755,nosuid,nodev media /media
}

case "$1" in
start) start ;;
stop) ;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
