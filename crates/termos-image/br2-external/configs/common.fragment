# TermOS on every board (D-074). Merged onto Buildroot's board defconfig;
# `cargo xtask image build` checks every setting survived.

# Bootlin's prebuilt glibc toolchain (D-014): no compiler to build.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y

BR2_TARGET_GENERIC_HOSTNAME="termos"
BR2_TARGET_GENERIC_ISSUE="TermOS"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# A read-only root (squashfs); writable state lives on the data partition.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_GENERIC_GETTY is not set
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_TERMOS_PATH)/board/common/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_TERMOS_PATH)/board/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_TERMOS_PATH)/board/common/post-image.sh"

# The console and what it needs.
BR2_PACKAGE_TERMOS=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_CA_CERTIFICATES=y

# The network (D-072): iwd for Wi-Fi, dhcpcd for addresses.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_IWD=y
BR2_PACKAGE_DHCPCD=y

# The data partition is ext4.
BR2_PACKAGE_E2FSPROGS=y

BR2_TARGET_ROOTFS_SQUASHFS=y
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_TAR is not set

# The disk image.
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y

# A/B updates (D-078): RAUC and its service, its host tool for bundles,
# the kernel inside the root file system, sudo for `termos system`.
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_DBUS=y
BR2_PACKAGE_HOST_RAUC=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_PACKAGE_SUDO=y

# Growing the data partition and installing from the live ISO (D-080).
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_ZSTD=y
