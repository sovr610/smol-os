# x86_64 PCs: one disk image that boots with BIOS and UEFI (D-075).
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_STABLE=y
BR2_ROOTFS_POST_SCRIPT_ARGS="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_TERMOS_PATH)/board/common/linux.fragment"
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BOOT_PARTITION="hd0,msdos1"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat squash4 part_msdos part_gpt normal biosdisk echo configfile loadenv test regexp"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 part_msdos part_gpt normal efi_gop echo configfile loadenv test regexp"
# The base configuration's network manager: iwd and dhcpcd do its work
# here (D-072).
# BR2_PACKAGE_CONNMAN is not set
# A/B updates (D-078): grub-editenv on the system, for RAUC's GRUB backend
# (the rest of GRUB's tools are removed after the build).
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
# The live ISO (D-080): the root file system again as an initramfs, and
# xorriso to make the ISO after the disk image.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_ZSTD=y
BR2_PACKAGE_HOST_XORRISO=y
